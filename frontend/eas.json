{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_ANDROID_ARCHS": "arm64-v8a"
      }
    },
    "preview-universal": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_ANDROID_ARCHS": "armeabi-v7a,arm64-v8a,x86,x86_64"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_ANDROID_ARCHS": "arm64-v8a"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
