{
  "expo": {
    "name": "MealBox",
    "slug": "mealbox-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A6B3A"
    },
    "updates": {
      "url": "https://u.expo.dev/d97b53ea-23cd-40b2-903d-6cd5e21269e9"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mealbox.app"
    },
    "android": {
      "package": "com.mealbox.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A6B3A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-updates",
      "./plugins/withCleartextTraffic.js",
      "./plugins/withAndroidCompress.js"
    ],
    "extra": {
      "eas": {
        "projectId": "d97b53ea-23cd-40b2-903d-6cd5e21269e9"
      }
    }
  }
}
